function showTab(name,btn){
  document.querySelectorAll(".tab-content").forEach(d=>d.style.display="none");
  document.querySelectorAll(".tab-btn").forEach(b=>b.classList.remove("active"));
  document.getElementById("tab-"+name).style.display="block";
  btn.classList.add("active");
  document.getElementById("filtros-insumos").style.display = name==="insumos" ? "block" : "none";
  document.getElementById("filtros-capex").style.display   = name==="capex"   ? "block" : "none";
}

function toggleCapex(graf,btn){
  document.querySelectorAll(".cap-filtro-btn").forEach(b=>b.classList.remove("active-f"));
  btn.classList.add("active-f");
  document.getElementById("cap-view-todos").style.display = graf==="todos" ? "" : "none";
  document.getElementById("cap-view-main").style.display  = graf==="main"  ? "" : "none";
  document.getElementById("cap-view-fk").style.display    = graf==="fk"    ? "" : "none";
  document.getElementById("cap-view-tipo").style.display  = graf==="tipo"  ? "" : "none";
}

function toggleSeccion(seccion, btn){
  btn.classList.toggle("off");
  const on = !btn.classList.contains("off");
  document.querySelectorAll("[data-seccion='"+seccion+"']").forEach(el=>{
    el.style.display = on ? "" : "none";
  });
}
