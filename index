.topbar-title{font-size:19px;font-weight:700;color:#2C2C2A;text-align:center}
.topbar-sub{font-size:10px;color:#888780;text-align:center;margin-top:2px}
.body{display:flex;flex:1;overflow:hidden}
.sidebar{width:175px;flex-shrink:0;background:white;border-right:1px solid #E0DED8;display:flex;flex-direction:column;overflow:hidden}
.sidebar-top{padding:16px 0 0;flex-shrink:0}
.sidebar-label{font-size:9px;font-weight:700;letter-spacing:0.08em;color:#888780;padding:0 14px 8px;text-transform:uppercase}
.tab-btn{display:block;width:100%;text-align:left;padding:9px 14px;background:none;border:none;cursor:pointer;font-size:13px;color:#666;border-left:3px solid transparent;transition:all .15s}
.tab-btn:hover{background:#F8F7F4;color:#2C2C2A}
.tab-btn.active{font-weight:600;color:#2C2C2A}
.dur-block{padding:12px 14px;border-top:1px solid #E0DED8;margin-top:12px;flex-shrink:0}
.dur-title{font-size:9px;font-weight:700;color:#888780;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:8px}
.dur-item{display:flex;align-items:center;gap:6px;margin-bottom:7px}
.dur-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.dur-lbl{font-size:10px;color:#2C2C2A;flex:1}
.dur-val{font-size:10px;font-weight:600;color:#2C2C2A}
.mini-block{padding:8px 10px 10px;border-top:1px solid #E0DED8;flex:1;display:flex;flex-direction:column;min-height:0}
.mini-title{font-size:9px;font-weight:700;color:#888780;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;text-align:center;flex-shrink:0}
.mini-canvas-wrap{flex:1;position:relative;min-height:0}
.content{flex:1;overflow-y:auto;padding:16px 20px}
.tab-content{display:none}
.tab-content.active{display:block}
.kpi-row{display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap}
.kpi{flex:1;min-width:110px;background:white;border-radius:8px;padding:10px 12px;border:0.5px solid #E0DED8;border-left:3px solid var(--kc)}
.kpi .val{font-size:13px;font-weight:700;color:var(--kc);line-height:1.1}
.kpi .lbl{font-size:8px;color:#888780;text-transform:uppercase;letter-spacing:0.04em;margin-top:3px}
.sec-title{font-size:14px;font-weight:700;color:#2C2C2A;padding:0 0 6px;border-bottom:2px solid #E0DED8;margin-bottom:12px;margin-top:18px;text-align:center}
.sec-title:first-child{margin-top:0}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:14px}
.card{background:white;border-radius:9px;padding:13px;border:0.5px solid #E0DED8}
.card h3{font-size:13px;font-weight:700;color:#2C2C2A;text-transform:none;letter-spacing:0;margin-bottom:11px;text-align:center}
.card canvas{max-height:200px}
.filtros{padding:6px 10px;border-top:1px solid #E0DED8;margin-top:4px;flex-shrink:0}
.filtros-title{font-size:9px;font-weight:700;color:#888780;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:8px}
.filtro-btn{display:flex;align-items:center;gap:7px;width:100%;padding:6px 4px;background:none;border:none;cursor:pointer;border-radius:5px;margin-bottom:3px;transition:background .12s}
.filtro-btn:hover{background:#F8F7F4}
.filtro-dot{width:10px;height:10px;border-radius:3px;flex-shrink:0;transition:opacity .2s}
.filtro-lbl{font-size:11px;color:#2C2C2A;font-weight:500;flex:1;text-align:left}
.filtro-btn.off .filtro-dot{opacity:0.25}
.filtro-btn.off .filtro-lbl{color:#aaa}
.filtro-btn.active-f{background:#F0F0F0}
.filtro-btn.active-f .filtro-lbl{font-weight:700;color:#2C2C2A}
